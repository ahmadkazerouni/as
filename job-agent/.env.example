# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override the model (default claude-opus-5)
# CLAUDE_MODEL=claude-opus-5

# Telegram notifications (create a bot with @BotFather, get chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set to 0 to watch the browser while it fills forms
HEADLESS=1
